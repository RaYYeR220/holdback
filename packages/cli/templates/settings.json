{
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "{{holdback}} hook guard --app {{app}}", "onFailure": "block" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "{{holdback}} hook post-edit --app {{app}}", "asyncRewake": true, "timeout": 900 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "{{holdback}} hook stop --app {{app}}", "timeout": 900 }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "{{holdback}} hook prompt --app {{app}}" }]
      }
    ]
  }
}
